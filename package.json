
{
  "name": "saucedemo-webdriverio-cucumber",
  "version": "1.0.0",
  "private": false,
  "description": "SauceDemo UI automation training framework using WebdriverIO, JavaScript, Cucumber BDD and Page Object Model.",
  "main": "wdio.conf.js",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
   

    "test:smoke": "wdio run ./wdio.conf.js --cucumberOpts.tags=@smoke",
"test:regression": "wdio run ./wdio.conf.js --cucumberOpts.tags=@regression",

    "test:login": "wdio run ./wdio.conf.js --spec ./features/login.feature",
    "test:checkout": "wdio run ./wdio.conf.js --spec ./features/checkout.feature",
    "report:allure": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },
  "keywords": [
    "webdriverio",
    "javascript",
    "cucumber",
    "saucedemo",
    "automation",
    "bdd",
    "pom"
  ],
  "license": "MIT",
  "devDependencies": {
    "@wdio/cli": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/cucumber-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/allure-reporter": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "allure-commandline": "^2.34.0",
    "dotenv": "^16.4.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
